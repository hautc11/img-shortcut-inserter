{
  "manifest_version": 3,
  "name": "Image Shortcut Paster",
  "version": "1.0.0",
  "description": "Dán ảnh đã lưu vào rich text editor bằng tổ hợp phím tùy chỉnh.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Shortcut Paster"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
